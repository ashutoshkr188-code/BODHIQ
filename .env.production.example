# ─── .env.production.example — Copy to .env.production on your AWS EC2 server ─
# NEVER commit .env.production to git

# ── Database — AWS RDS PostgreSQL ────────────────────────────────────────────
# Create: RDS → PostgreSQL 15 → db.t3.micro → bodhiq DB → sg allows EC2 only
DATABASE_URL=postgresql+psycopg2://bodhiq:STRONG_PASSWORD_HERE@YOUR-RDS-ENDPOINT.ap-south-1.rds.amazonaws.com:5432/bodhiq

# ── Clerk Authentication ─────────────────────────────────────────────────────
# Use PRODUCTION keys (not test keys) from Clerk dashboard
CLERK_SECRET_KEY=clerk_live_secret_key_placeholder
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_JWKS_URL=https://clerk.bodhiq.in/.well-known/jwks.json

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Razorpay Payments ────────────────────────────────────────────────────────
# Use LIVE keys for production (after KYC approval on Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# ── Frontend Config ───────────────────────────────────────────────────────────
# Your production domain pointing to AWS ALB
NEXT_PUBLIC_API_URL=https://www.bodhiq.in

# ── CORS & Security ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://www.bodhiq.in,https://bodhiq.in
FRONTEND_URL=https://www.bodhiq.in

# ── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
# (Mount AWS EFS at /app/uploads for persistence)
