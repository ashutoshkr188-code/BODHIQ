# ─── BODHIQ .gitignore ────────────────────────────────────────────────────────

# ── Environment files (NEVER commit) ─────────────────────────────────────────
.env
.env.local
.env.production
.env.development
.env.staging
*.env

# ── SQLite databases ─────────────────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
bodhiq.db


# ── Uploaded media ───────────────────────────────────────────────────────────
backend/uploads/
uploads/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
.env/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log

# ── Next.js build ─────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/.cache/
*.tsbuildinfo

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.vim/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ───────────────────────────────────────────────────────────────────
# docker-compose.override.yml is intentionally ignored
docker-compose.override.yml

# ── Alembic ──────────────────────────────────────────────────────────────────
# Keep versions — they define the DB schema

# ── Cert files ───────────────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.csr
