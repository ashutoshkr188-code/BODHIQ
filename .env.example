# ─── .env.example — Copy this to .env for local development ──────────────────
# DO NOT commit .env to git — add it to .gitignore

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (default for local docker-compose):
DATABASE_URL=sqlite:////data/bodhiq.db

# PostgreSQL (use for production — replace with your RDS endpoint):
# DATABASE_URL=postgresql+psycopg2://bodhiq:yourpassword@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/bodhiq

# ── Clerk Authentication ─────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Frontend (Next.js) — prefix NEXT_PUBLIC_ is exposed to the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Razorpay Payments ────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ── Frontend Config ───────────────────────────────────────────────────────────
# Local: http://localhost (Nginx on port 80)
# Production: https://www.bodhiq.in
NEXT_PUBLIC_API_URL=http://localhost

# ── CORS & Security ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost
FRONTEND_URL=http://localhost:3000

# ── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
